# OpenRouter key (https://openrouter.ai/keys). Server-side only, never shipped to the browser.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Cheap and good at JSON is the goal.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Local dev only: run prompts through the Claude Code CLI instead of OpenRouter.
# LLM_PROVIDER=claude-cli
